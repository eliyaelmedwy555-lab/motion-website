# Motion Hub — environment values
# Copy this file to ".env"  (which is gitignored)  and fill in your values.
#   PowerShell:  copy .env.example .env
# Then run:  docker compose up -d
# Docker Compose loads .env automatically.

# --- URLs ---
# Phase 1 (local only): leave these as localhost.
# Phase 2/3 (connecting channels): set all THREE to your stable ngrok HTTPS URL,
# e.g. https://motion-eliya.ngrok-free.app  (keep the /api on the backend one).
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api

# --- Secret (unique per install; a random one is pre-filled) ---
JWT_SECRET=lsZXVpPg6ROgxkfeBmxkVTRJEH50JMywaELQGI71hbSFdVP

# --- Platform keys (fill in Phase 2 / 3) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
